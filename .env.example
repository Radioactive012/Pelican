# ==============================================================================
# Context Passport - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMS=1536

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=context_passport
MONGODB_COLLECTION_NAME=memories
MONGODB_VECTOR_INDEX_NAME=memories_vector_index_scoped

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Service / Server
PORT=8000
HOST=0.0.0.0
BUILD_MARKER=context-passport-v0-build-001
RENDER_EXTERNAL_URL=
MEM0_HISTORY_DB_PATH=backend/mem0_history.db
